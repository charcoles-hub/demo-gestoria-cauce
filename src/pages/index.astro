---
const HERO = "https://images.unsplash.com/photo-1573497491208-6b1acb260507";
const DOCS = "https://images.unsplash.com/photo-1554224155-6726b3ff858f";

const servicios = [
  {
    t: "Fiscal",
    d: "IVA, IRPF, Sociedades, Renta. Presentado dentro de plazo y explicado sin jerga, para que sepas qué pagas y por qué.",
  },
  {
    t: "Laboral",
    d: "Nóminas, contratos, altas y bajas, Seguridad Social. Tu equipo cobra lo que toca, cuando toca, sin líos.",
  },
  {
    t: "Contable",
    d: "Cuentas al día todo el año, no solo en campaña. Sabrás cómo va tu negocio con solo preguntar.",
  },
];

const razones = [
  { t: "Respuesta en 24h", d: "Nunca un buzón de voz. Escribes y te contesta la persona que lleva tu caso." },
  { t: "Un gestor, no un turno", d: "Siempre la misma persona conoce tu negocio: no repites la historia cada vez." },
  { t: "Números explicados", d: "Reunión trimestral para leer juntos las cuentas, no solo para firmarlas." },
];

const facts = [
  { n: "16", l: "años en el Baix Llobregat" },
  { n: "310+", l: "empresas y autónomos asesorados" },
  { n: "24h", l: "tiempo medio de respuesta" },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Cauce · Gestoría fiscal, laboral y contable en Sant Joan Despí. Asesoramiento cercano para autónomos y pymes del Baix Llobregat, sin sustos ni jerga." />
    <title>Cauce · Gestoría en Sant Joan Despí</title>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,500;0,600;0,700;1,500&family=Red+Hat+Text:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="bar">
      <a href="#top" class="brand">Cauce</a>
      <nav class="bar-nav">
        <a href="#servicios">Servicios</a>
        <a href="#nosotros">Por qué Cauce</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a href="#contacto" class="btn btn-sm">Primera consulta</a>
    </header>

    <main id="top">
      <!-- HERO -->
      <section class="hero">
        <div class="hero-copy">
          <p class="kicker">Gestoría · Sant Joan Despí</p>
          <h1>Tu papeleo,<br /><em>en su cauce.</em></h1>
          <p class="lead">Llevamos lo fiscal, laboral y contable de autónomos y pymes del Baix Llobregat para que dejes de mirar el calendario con miedo. Un gestor fijo, respuesta rápida, cero sorpresas en marzo.</p>
          <div class="hero-cta">
            <a href="#contacto" class="btn">Pedir primera consulta</a>
            <a href="tel:+34936000000" class="link-soft">o llama: 936 00 00 00</a>
          </div>
        </div>
        <figure class="hero-figure" data-parallax>
          <img src={`${HERO}?auto=format&fit=crop&w=1200&q=80`} alt="Reunión de asesoramiento entre una gestora y su clienta en una oficina luminosa" loading="eager" />
          <figcaption class="floater">
            <strong>310+</strong>
            <span>negocios que ya no llevan las cuentas con sudores fríos</span>
          </figcaption>
        </figure>
      </section>

      <!-- Confianza -->
      <section class="trust">
        {facts.map((f) => (
          <div class="fact">
            <span class="fact-n">{f.n}</span>
            <span class="fact-l">{f.l}</span>
          </div>
        ))}
        <p class="trust-note">Colegiados AEAT · Gestión administrativa nº 4471</p>
      </section>

      <!-- Servicios -->
      <section id="servicios" class="services">
        <h2>Tres frentes.<br />Uno solo se encarga de todos.</h2>
        <div class="service-list">
          {servicios.map((s) => (
            <article class="service-row" data-reveal>
              <span class="service-mark"></span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Por qué Cauce (banda oscura) -->
      <section id="nosotros" class="why">
        <div class="why-media" data-reveal>
          <img src={`${DOCS}?auto=format&fit=crop&w=1000&q=80`} alt="Documentos fiscales y calculadora ordenados sobre una mesa de madera" loading="lazy" />
        </div>
        <div class="why-copy">
          <h2>No somos la gestoría<br />que archiva y calla.</h2>
          <ul class="reasons">
            {razones.map((r) => (
              <li data-reveal>
                <h3>{r.t}</h3>
                <p>{r.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Resultado destacado -->
      <section class="result" data-reveal>
        <p class="result-stat">El <span>94%</span> de nuestros clientes lleva <em>más de 5 años</em> con nosotros.</p>
        <p class="result-sub">No es fidelización forzada. Es que da pereza volver a explicarle tu negocio a otro.</p>
      </section>

      <!-- Testimonio -->
      <section class="quote">
        <blockquote data-reveal>
          <p>“Antes cada trimestre era una pelea de emails sin contestar. Con Cauce sé lo que voy a pagar antes de que llegue el aviso, y sé quién me lo va a explicar si no lo entiendo.”</p>
          <cite>— Mireia Prat, óptica en Sant Joan Despí</cite>
        </blockquote>
      </section>

      <!-- Contacto -->
      <section id="contacto" class="book">
        <div class="book-info">
          <h2>Empieza con una<br />consulta sin coste.</h2>
          <p class="book-lead">30 minutos para revisar tu situación y decirte, sin rodeos, si podemos ayudarte y cuánto costaría.</p>
          <dl class="contact">
            <div><dt>Dónde</dt><dd>Carrer de Sant Josep 12<br />08970 Sant Joan Despí</dd></div>
            <div><dt>Horario</dt><dd>Lun–Vie · 09:00 – 18:30</dd></div>
            <div><dt>Teléfono</dt><dd>936 00 00 00 · WhatsApp</dd></div>
          </dl>
        </div>
        <form class="book-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="TU-ACCESS-KEY-WEB3FORMS" />
          <input type="hidden" name="subject" value="Nueva consulta: Cauce" />
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" />
          <h3>Solicita tu consulta gratuita</h3>
          <label>Nombre<input name="name" required autocomplete="name" /></label>
          <label>Teléfono<input name="phone" required autocomplete="tel" inputmode="tel" /></label>
          <label>¿Qué necesitas?
            <select name="motivo">
              <option>Alta de autónomo o sociedad</option>
              <option>Llevar la fiscal y contable</option>
              <option>Nóminas y laboral</option>
              <option>Cambiar de gestoría</option>
              <option>Otro / no estoy seguro</option>
            </select>
          </label>
          <button type="submit" class="btn btn-block">Pedir consulta gratuita</button>
          <p class="form-note">Te llamamos en menos de 24 h laborables. Sin permanencia.</p>
        </form>
      </section>
    </main>

    <footer class="foot">
      <span class="brand sm">Cauce</span>
      <p>Gestoría fiscal, laboral y contable · Sant Joan Despí</p>
      <div class="foot-links"><a href="#">LinkedIn</a><a href="#">Aviso legal</a></div>
    </footer>

    <script>
      const io = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { threshold: 0.18 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      const parallax = document.querySelector('[data-parallax]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (parallax && !reduceMotion) {
        let ticking = false;
        addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const r = parallax.getBoundingClientRect();
            const shift = Math.max(-24, Math.min(24, r.top * 0.06));
            parallax.style.transform = `translateY(${shift}px)`;
            ticking = false;
          });
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f2f0ea;
    --paper: #fffdf8;
    --stone: #e8e4d9;
    --ink: #1c2333;
    --navy: #223258;
    --navy-deep: #16213b;
    --slate: #5b6478;
    --gold: #b3872f;
    --gold-deep: #8f6b21;
    --line: #dcd7c9;
    --display: "Instrument Sans", system-ui, sans-serif;
    --ui: "Red Hat Text", system-ui, sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg); color: var(--ink);
    font-family: var(--ui); font-size: 17px; line-height: 1.6;
    -webkit-font-smoothing: antialiased; overflow-x: hidden;
  }
  ::selection { background: var(--gold); color: #fff; }
  a { color: inherit; text-decoration: none; }
  em { font-style: normal; color: var(--gold-deep); }

  .kicker {
    font-size: 13px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--navy); font-weight: 600; margin-bottom: 22px;
  }

  .btn {
    display: inline-block; font-family: var(--display); font-weight: 600; font-size: 16px;
    padding: 15px 28px; border-radius: 10px; background: var(--navy); color: #fff;
    border: 1px solid var(--navy); transition: transform .2s, background .25s, box-shadow .25s;
  }
  .btn:hover { background: var(--navy-deep); transform: translateY(-2px); box-shadow: 0 14px 30px -14px rgba(22,33,59,.6); }
  .btn-sm { padding: 11px 20px; font-size: 15px; }
  .btn-block { width: 100%; padding: 16px; }
  .link-soft { color: var(--slate); font-weight: 500; }
  .link-soft:hover { color: var(--navy); }

  /* Bar */
  .bar {
    position: sticky; top: 0; z-index: 30;
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px clamp(24px, 6vw, 80px);
    background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .brand { font-family: var(--display); font-weight: 700; font-size: 25px; letter-spacing: -.02em; color: var(--navy); }
  .brand.sm { font-size: 21px; color: var(--paper); }
  .bar-nav { display: flex; gap: 32px; font-size: 15px; }
  .bar-nav a { color: var(--slate); transition: color .25s; }
  .bar-nav a:hover { color: var(--navy); }

  /* HERO */
  .hero {
    display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(30px, 5vw, 64px);
    align-items: center; padding: clamp(48px, 7vw, 96px) clamp(24px, 6vw, 80px) clamp(40px, 5vw, 64px);
  }
  .hero h1 {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(42px, 6.6vw, 76px); line-height: .98; letter-spacing: -.03em; margin-bottom: 26px;
  }
  .lead { max-width: 46ch; color: #454e63; font-size: clamp(16px, 1.5vw, 19px); }
  .hero-cta { display: flex; align-items: center; gap: 26px; margin-top: 36px; flex-wrap: wrap; }
  .hero-copy { animation: rise .9s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }

  .hero-figure {
    position: relative; border-radius: 20px; overflow: hidden;
    box-shadow: 0 30px 60px -40px rgba(22,33,59,.5); animation: rise 1.1s .15s cubic-bezier(.2,.7,.2,1) both;
    will-change: transform;
  }
  .hero-figure img { width: 100%; height: clamp(340px, 42vw, 480px); object-fit: cover; display: block; }
  .floater {
    position: absolute; left: 20px; right: 20px; bottom: 20px;
    background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(8px);
    border-radius: 14px; padding: 16px 20px; display: flex; align-items: baseline; gap: 12px;
    box-shadow: 0 20px 40px -24px rgba(22,33,59,.5);
  }
  .floater strong { font-family: var(--display); font-weight: 700; font-size: 26px; color: var(--navy); flex-shrink: 0; }
  .floater span { font-size: 13.5px; color: var(--slate); line-height: 1.35; }

  /* Trust */
  .trust {
    display: flex; flex-wrap: wrap; align-items: center; gap: clamp(24px, 5vw, 64px);
    padding: 30px clamp(24px, 6vw, 80px); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    background: var(--stone);
  }
  .fact { display: flex; flex-direction: column; }
  .fact-n { font-family: var(--display); font-weight: 700; font-size: clamp(28px, 3.4vw, 40px); color: var(--navy); line-height: 1; }
  .fact-l { font-size: 13.5px; color: var(--slate); margin-top: 6px; max-width: 18ch; }
  .trust-note { margin-left: auto; font-size: 14px; color: var(--slate); }

  section { padding-left: clamp(24px, 6vw, 80px); padding-right: clamp(24px, 6vw, 80px); }
  [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
  [data-reveal].in { opacity: 1; transform: none; }

  /* Servicios */
  .services { padding-top: clamp(64px, 9vw, 120px); padding-bottom: clamp(56px, 8vw, 100px); }
  .services h2 {
    font-family: var(--display); font-weight: 700; max-width: 16ch;
    font-size: clamp(32px, 4.6vw, 54px); line-height: 1.05; letter-spacing: -.025em; margin-bottom: 54px;
  }
  .service-list { border-top: 1px solid var(--line); }
  .service-row {
    display: grid; grid-template-columns: 10px 1fr 2fr; gap: clamp(16px, 3vw, 40px);
    align-items: baseline; padding: clamp(28px, 3.4vw, 40px) 0; border-bottom: 1px solid var(--line);
    transition: transform .3s ease;
  }
  .service-row:hover { transform: translateX(10px); }
  .service-mark { width: 10px; height: 10px; border-radius: 3px; background: var(--gold-deep); align-self: center; }
  .service-row:nth-child(2) .service-mark { background: var(--navy); }
  .service-row:nth-child(3) .service-mark { background: var(--slate); }
  .service-row h3 { font-family: var(--display); font-weight: 600; font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -.01em; }
  .service-row p { color: #56607a; max-width: 52ch; }

  /* Por qué (banda navy) */
  .why {
    display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(30px, 5vw, 64px); align-items: center;
    background: var(--navy-deep); border-radius: 28px; margin: 0 clamp(12px, 3vw, 40px);
    padding-top: clamp(56px, 8vw, 100px); padding-bottom: clamp(56px, 8vw, 100px); color: #fff;
  }
  .why-media { border-radius: 18px; overflow: hidden; box-shadow: 0 30px 60px -30px rgba(0,0,0,.5); }
  .why-media img { width: 100%; height: clamp(320px, 32vw, 420px); object-fit: cover; display: block; }
  .why-copy h2 { font-family: var(--display); font-weight: 700; font-size: clamp(28px, 3.6vw, 42px); line-height: 1.08; letter-spacing: -.02em; margin-bottom: 40px; }
  .reasons { list-style: none; display: grid; gap: 26px; }
  .reasons li { border-top: 1px solid rgba(255,255,255,.16); padding-top: 20px; }
  .reasons h3 { font-family: var(--display); font-weight: 600; font-size: 20px; margin-bottom: 8px; color: #f2d99a; }
  .reasons p { color: #b7bfd4; }

  /* Resultado */
  .result { text-align: center; max-width: 920px; margin: 0 auto; padding-top: clamp(64px, 9vw, 120px); padding-bottom: clamp(24px, 3vw, 40px); }
  .result-stat { font-family: var(--display); font-weight: 700; font-size: clamp(28px, 4.4vw, 50px); line-height: 1.12; letter-spacing: -.02em; }
  .result-stat span { color: var(--navy); }
  .result-sub { margin-top: 22px; color: var(--slate); font-size: clamp(16px, 1.6vw, 19px); }

  /* Testimonio */
  .quote { text-align: center; padding-top: clamp(48px, 6vw, 80px); padding-bottom: clamp(64px, 9vw, 120px); }
  .quote blockquote { max-width: 860px; margin: 0 auto; }
  .quote p { font-family: var(--display); font-weight: 500; font-size: clamp(22px, 3.2vw, 36px); line-height: 1.28; letter-spacing: -.01em; }
  .quote cite { display: block; margin-top: 26px; font-style: normal; font-size: 14px; letter-spacing: .1em; text-transform: uppercase; color: var(--slate); }

  /* Contacto */
  .book { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(34px, 6vw, 84px); align-items: center; padding-top: clamp(48px, 7vw, 96px); padding-bottom: clamp(64px, 9vw, 120px); }
  .book h2 { font-family: var(--display); font-weight: 700; font-size: clamp(30px, 4.2vw, 50px); line-height: 1.05; letter-spacing: -.025em; }
  .book-lead { margin-top: 20px; max-width: 42ch; color: var(--slate); font-size: 16.5px; }
  .contact { margin-top: 36px; display: grid; gap: 22px; }
  .contact dt { font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-deep); font-weight: 600; margin-bottom: 6px; }
  .contact dd { color: var(--ink); line-height: 1.5; }
  .book-form { background: var(--paper); border: 1px solid var(--line); border-radius: 22px; padding: clamp(26px, 3vw, 40px); box-shadow: 0 30px 70px -44px rgba(22,33,59,.35); }
  .book-form h3 { font-family: var(--display); font-weight: 600; font-size: 25px; margin-bottom: 24px; letter-spacing: -.01em; }
  .book-form label { display: block; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--slate); font-weight: 600; margin-bottom: 18px; }
  .book-form input, .book-form select {
    width: 100%; margin-top: 8px; padding: 13px 14px; background: var(--bg);
    border: 1px solid var(--line); border-radius: 10px; color: var(--ink);
    font-family: var(--ui); font-size: 16px; text-transform: none; letter-spacing: normal; font-weight: 400;
    transition: border-color .25s, background .25s;
  }
  .book-form input:focus, .book-form select:focus { outline: none; border-color: var(--navy); background: var(--paper); }
  .form-note { text-align: center; font-size: 13.5px; color: var(--slate); margin-top: 16px; text-transform: none; letter-spacing: normal; font-weight: 400; }

  /* Footer */
  .foot {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;
    padding: 34px clamp(24px, 6vw, 80px); background: var(--navy-deep); color: #b7bfd4;
  }
  .foot p { font-size: 14px; }
  .foot-links { display: flex; gap: 22px; font-size: 14px; }
  .foot-links a { color: #b7bfd4; transition: color .25s; }
  .foot-links a:hover { color: #fff; }

  @media (max-width: 860px) {
    .bar-nav { display: none; }
    .hero { grid-template-columns: 1fr; }
    .hero-figure img { height: 320px; }
    .service-row { grid-template-columns: 1fr; gap: 10px; }
    .service-row:hover { transform: none; }
    .why { grid-template-columns: 1fr; border-radius: 20px; }
    .book { grid-template-columns: 1fr; }
    .trust-note { margin-left: 0; width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, [data-reveal] { animation: none !important; transition: none !important; opacity: 1 !important; transform: none !important; }
  }
</style>
